{
  "name": "front-enjoy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @front-enjoy/frontend dev",
    "dev:backend": "pnpm --filter @front-enjoy/backend dev",
    "build": "pnpm --filter @front-enjoy/frontend build",
    "preview": "pnpm --filter @front-enjoy/frontend preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  }
}
